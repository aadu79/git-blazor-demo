
@inject IJSRuntime JS

<link href="css/jobdetails.css" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet" />

<div class="job-details-overlay">
    <div class="job-details-card">
        <div class="job-details-header">
            <h3>Job Details</h3>
            <div class="red-underline"></div>
        </div>

        <EditForm Model="@job" OnValidSubmit="HandleValidSubmit">
            <div class="job-details-container">
                <!-- LEFT SECTION -->
                <div class="job-left">
                    <div class="form-group">
                        <label>Job ID</label>
                        <InputText @bind-Value="job.JobId" class="form-control" placeholder="Enter Job ID" />
                    </div>

                    <div class="form-group">
                        <label>Client Name</label>
                        <InputText @bind-Value="job.ClientName" class="form-control" placeholder="Enter Client Name" />
                    </div>

                    <div class="form-group">
                        <label>Consignee Name</label>
                        <InputText @bind-Value="job.ConsigneeName" class="form-control" placeholder="Enter Consignee Name" />
                    </div>

                    <div class="form-group">
                        <label>ETA</label>
                        <InputDate @bind-Value="job.ETA" class="form-control" />
                    </div>

                    <div class="form-group">
                        <label>ETD</label>
                        <InputDate @bind-Value="job.ETD" class="form-control" />
                    </div>

                    <div class="location-row">
                        <i class="bi bi-geo-alt-fill location-icon"></i>
                        <InputText @bind-Value="job.Origin" class="form-control small-input" placeholder="From" />
                        <i class="bi bi-arrow-right mx-2"></i>
                        <InputText @bind-Value="job.Destination" class="form-control small-input" placeholder="To" />
                    </div>
                </div>

                <!-- VERTICAL DIVIDER -->
                <div class="divider-line"></div>

                <!-- RIGHT SECTION -->
                <div class="job-right">
                    <ul class="status-list">
                        <li class="status-header-inside">
                            <span class="current-status-label"><b>Current Status:</b></span>
                            <span class="status-badge">@currentStatus</span>
                        </li>

                        @foreach (var status in statuses)
                        {
                            <li class="status-item @(currentStatus == status ? "active-status" : "")"
                                @onclick="@(() => SelectStatus(status))">
                                <span class="status-text">@status</span>
                                <span class="status-circle @(currentStatus == status ? "selected" : "")"></span>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <!-- BOTTOM BUTTONS -->
            <div class="bottom-buttons">
                <button type="button" class="btn btn-primary" @onclick="ShowPOD">👁 View POD</button>
                <button type="submit" class="btn btn-success">Approve</button>
                <button type="button" class="btn btn-danger">Reject</button>
            </div>
        </EditForm>
    </div>
</div>

<!-- ✅ POD POPUP OVERLAY -->
@if (showPOD)
{
    <div class="pod-overlay">
        <div class="pod-container">
            <img src="images/pod-sample.png" alt="POD Image" class="pod-image" />

            <!-- icons inside image area -->
            <button class="pod-btn close-btn" @onclick="ClosePOD">✖</button>
            <button class="pod-btn download-btn" @onclick="DownloadPOD">⬇</button>
        </div>
    </div>
}

@code {
    private Job job = new();
    private string currentStatus = "Cargo Received";
    private bool showPOD = false;

    private List<string> statuses = new()
    {
        "Shipment Confirmation", "Cargo Received", "In-Transit",
        "Arrival at Destination", "Customs Clearance Complete",
        "Arrival at Destination Hub", "Out for Delivery", "Delay Notification",
        "Delivery Confirmation", "Feedback/NPS"
    };

    void SelectStatus(string status) => currentStatus = status;
    void HandleValidSubmit() { }

    void ShowPOD() => showPOD = true;
    void ClosePOD() => showPOD = false;

    async Task DownloadPOD()
    {
        await JS.InvokeVoidAsync("downloadFile", "images/pod-sample.png", "POD_Image.png");
    }

    public class Job
    {
        public string JobId { get; set; }
        public string ClientName { get; set; }
        public string ConsigneeName { get; set; }
        public DateTime? ETA { get; set; }
        public DateTime? ETD { get; set; }
        public string Origin { get; set; }
        public string Destination { get; set; }
    }
}
