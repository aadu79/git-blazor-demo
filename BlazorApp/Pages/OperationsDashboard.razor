@page "/operations"
@layout Layout.DashboardLayout
@inject NavigationManager Navigation


<div class="dashboard-container">
    <h2>Job Details</h2>
    <div class="top-bar">
        <div class="filter-container">
            <button class="filter-btn">
                Filter
                <img src="/sample-data/filter.png" alt="Filter" class="filter-icon" />
                
            </button>
        </div>

    </div>
    <div class="card-container">
        @foreach (var job in PaginatedJobs)
        {
            <div class="job-card @(job.JobStatus == "Out for Delivery" ? "active" : "")">
                <div class="job-header">
                    <div class="job-logo">
                        <img src="/Cube.png" alt="Job Logo" />
                    </div>

                    <div class="job-info-row">
                        <div class="job-info">
                            <p class="label">Job ID:</p>
                            <p class="value">@job.JobId</p>
                        </div>
                        <div class="job-info">
                            <p class="label">Job Status:</p>
                            <p class="value">@job.JobStatus</p>
                        </div>
                    </div>
                </div>

                <hr class="card-line" />

                <div class="job-body">
                    <div class="eta-etd-row">
                        <div class="eta">
                            <p><strong>ETA:</strong> @job.ETA</p>
                        </div>
                        <div class="etd">
                            <p><strong>ETD:</strong> @job.ETD</p>
                        </div>
                    </div>

                    <div class="from-to-row">
                        <span class="from">@job.From</span>
                        <span class="arrow">→</span>
                        <span class="to">@job.To</span>
                    </div>
                </div>

                <div class="job-actions">
                    <button class="approve-btn">Approve</button>
                    <button class="view-btn" @onclick="GoToJobDetails">View</button>
                </div>
            </div>
        }
    </div>

    
    
    <!-- PAGINATION BAR (bottom center, modern style) -->
    <div class="pagination-container">
        <div class="pagination">
            <button class="nav-btn" @onclick="PreviousPage" disabled="@(_currentPage == 1)">
                ‹ Previous
            </button>

            @for (int i = 1; i <= TotalPages; i++)
            {
                <button class="page-number @(i == _currentPage ? "active" : "")" @onclick="(() => GoToPage(i))">
                    @i
                </button>
            }

            <button class="nav-btn" @onclick="NextPage" disabled="@(_currentPage == TotalPages)">
                Next ›
            </button>
        </div>
    </div>

</div>



@code {
    private List<dynamic> jobs = new();
    private int _currentPage = 1;
    private int _pageSize = 9;

    protected override void OnInitialized()
    {
        jobs = new()
        {
            new { JobId = "F124G375", JobStatus = "Out for Delivery", ETA = "24/09/2025", ETD = "01/10/2025", From = "123 Industrial Road", To = "456 Commerce Blvd" },
            new { JobId = "F124G376", JobStatus = "Cargo Received", ETA = "24/09/2025", ETD = "01/10/2025", From = "123 Industrial Road", To = "456 Commerce Blvd" },
            new { JobId = "F124G377", JobStatus = "In-Transit", ETA = "24/09/2025", ETD = "01/10/2025", From = "123 Industrial Road", To = "456 Commerce Blvd" },
            new { JobId = "F124G378", JobStatus = "In-Transit", ETA = "24/09/2025", ETD = "01/10/2025", From = "123 Industrial Road", To = "456 Commerce Blvd" },
            new { JobId = "F124G379", JobStatus = "Delivered", ETA = "25/09/2025", ETD = "02/10/2025", From = "789 Market Ave", To = "100 Tech Park" },
            new { JobId = "F124G380", JobStatus = "Out for Delivery", ETA = "26/09/2025", ETD = "03/10/2025", From = "123 Industrial Road", To = "987 Global Way" },
            new { JobId = "F124G381", JobStatus = "Cargo Received", ETA = "27/09/2025", ETD = "04/10/2025", From = "Warehouse A", To = "Distribution Center B" },
            new { JobId = "F124G382", JobStatus = "In-Transit", ETA = "28/09/2025", ETD = "05/10/2025", From = "Factory X", To = "Retail Hub Y" },
            new { JobId = "F124G383", JobStatus = "In-Transit", ETA = "29/09/2025", ETD = "06/10/2025", From = "Plant 4", To = "Store 12" },
            new { JobId = "F124G384", JobStatus = "Delivered", ETA = "30/09/2025", ETD = "07/10/2025", From = "Hub A", To = "Store Z" },
            new { JobId = "F124G385", JobStatus = "Out for Delivery", ETA = "01/10/2025", ETD = "08/10/2025", From = "Depot A", To = "Depot B" },
        };
    }

    private IEnumerable<dynamic> PaginatedJobs =>
        jobs.Skip((_currentPage - 1) * _pageSize).Take(_pageSize);

    private int TotalPages => (int)Math.Ceiling(jobs.Count / (double)_pageSize);

    private void NextPage()
    {
        if (_currentPage < TotalPages)
            _currentPage++;
    }

    private void PreviousPage()
    {
        if (_currentPage > 1)
            _currentPage--;
    }

    private void GoToPage(int pageNumber)
    {
        _currentPage = pageNumber;
    }

    private void GoToJobDetails()
    {
        Navigation.NavigateTo("/jobdetails");
    }
}