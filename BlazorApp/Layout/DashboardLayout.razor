@inherits LayoutComponentBase
@* using Microsoft.AspNetCore.Components *@

<div class="main-layout">
    <!-- Header now comes before sidebar -->
    <header class="header-bar">
        <h2>Operations Dashboard</h2>
        <div class="search-profile">
            <input type="text" placeholder="Search for something" />
            <img class="profile-pic" src="https://i.pravatar.cc/40" alt="Profile" />
        </div>
    </header>
    

    <div class="layout-body">
        <aside class="sidebar">
            <div class="logo ">
                <img src="/AstroMin_Logo_Transparent.png" alt="Logo" width="90" height="60" />
            </div>
            <nav>
                 <button class="nav-btn active">
                    <img src="/sample-data/operationicon.png" alt="Logo" class="nav-logo" />Operation Dashboard
                </button>
            </nav>
            <hr class="sidebar-line">
        </aside>

        <main class="page-content">
            @Body
        </main>
    </div>
</div>

